# =============================================================================
# .env.example — Local Development Environment Configuration
#
# Copy this file to .env and adjust as needed for your local setup.
# The defaults work with the Docker Compose stack defined in
# local_development/docker-compose.yml.
# =============================================================================

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database (PostgreSQL + pgvector via Docker Compose) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# --- S3 / Medallion Buckets (via LocalStack) ---
AWS_ENDPOINT_URL=http://localhost:4566
BRONZE_BUCKET=ai-catalog-bronze-dev
SILVER_BUCKET=ai-catalog-silver-dev
GOLD_BUCKET=ai-catalog-gold-dev
QUARANTINE_PREFIX=_quarantine
BRONZE_S3_PATHS=s3://ai-catalog-bronze-dev/

# --- AWS (LocalStack overrides) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=LOCAL_DEV_AKID
AWS_SECRET_ACCESS_KEY=LOCAL_DEV_SAK

# --- Bedrock Model IDs (not used in local dev, but set for safety) ---
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# --- Agent Graph ---
AGENT_MAX_RETRIES=3
QUALITY_THRESHOLD=0.95
GRAPH_TIMEOUT_SECONDS=600

# --- OpenTelemetry (empty = console exporter for local dev) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-data-catalog-agent

# --- Great Expectations ---
GX_EXPECTATION_SUITE=crm_users_suite

# --- dbt ---
DBT_TARGET=dev
DBT_PROFILES_DIR=./profiles

# --- File Size Limits ---
MAX_FILE_SIZE_BYTES=524288000